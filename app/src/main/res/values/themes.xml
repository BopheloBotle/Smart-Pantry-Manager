<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BlushPantry" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/blush_accent</item>
        <item name="colorPrimaryVariant">@color/blush_dark</item>
        <item name="colorOnPrimary">@color/card_white</item>
        <item name="colorSecondary">@color/blush_pink</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/blush_deep</item>
        <item name="android:navigationBarColor">@color/card_white</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorError">@color/error_rose</item>
        <item name="materialButtonStyle">@style/Widget.BlushPantry.Button</item>
    </style>

    <style name="Widget.BlushPantry.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/blush_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.BlushPantry.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/blush_accent</item>
        <item name="android:textColor">@color/blush_accent</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.BlushPantry.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
